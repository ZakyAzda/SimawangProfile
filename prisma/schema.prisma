generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  content     String
  category    String
  image       String?
  authorName  String
  views       Int      @default(0)
  publishedAt DateTime @default(now())
}

model GalleryItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  image       String
  description String?
  category    String?
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String @unique
  password String
  role     String @default("editor")
}

model DataKesehatan {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  jorong         String
  jumlahStunting Int
}

model DataNagari {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  nama   String
  jumlah Int
}

model DataSejarahBudaya {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  jorong     String
  namaTempat String
}

model DataPotensiAlam {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  kategori String
  jumlah   Int
}

model DataUmkm {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  jorong      String @default("-")
  productUmkm String
  jumlah      Float
}

model DataSanitasi {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  jorong      String
  sampahMS    Float  // % Tempat Sampah MS
  spalMS      Float  // % Rumah Punya SPAL MS
  jambanSehat Float  // % Jamban Sehat
  aksesAir    Float  // % Periode ODG Akses Berkelanjutan & TDA Air Minum Berkelanjutan
}

model Pengaduan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nama      String
  noWa      String?
  kategori  String
  jorong    String?
  laporan   String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

